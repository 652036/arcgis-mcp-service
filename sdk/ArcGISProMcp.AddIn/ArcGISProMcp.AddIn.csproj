<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AssemblyName>ArcGISProMcp.AddIn</AssemblyName>
    <RootNamespace>ArcGISProMcp.AddIn</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Esri.ArcGISPro.Extensions30" Version="3.6.0.59527" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Config.daml" />
    <Content Include="Config.daml" />
  </ItemGroup>
</Project>
